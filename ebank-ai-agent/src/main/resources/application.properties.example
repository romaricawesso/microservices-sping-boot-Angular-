spring.application.name=ebank-ai-agent
server.port=8085

# Google Gemini AI Configuration
# Copy this file to application.properties and set your API key
# Or set the GOOGLE_GENAI_API_KEY environment variable
spring.ai.google.genai.api-key=YOUR_GOOGLE_GENAI_API_KEY_HERE
spring.ai.chat.client.enabled=true
